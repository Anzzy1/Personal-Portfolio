# Copy to .env.local for local dev, and add the same values in Vercel.
# Vercel: Project -> Settings -> Environment Variables, then redeploy.

# Public URL used by SEO, the sitemap, robots.txt, and OG images.
# Read at build time, so changing it requires a redeploy.
NEXT_PUBLIC_SITE_URL=https://anzyy.online

# ------------------------------------------------------------------
# AI assistant (src/app/api/chat/route.ts)
# ------------------------------------------------------------------

# Groq API key — https://console.groq.com/keys (free tier available).
# Leave empty and the assistant uses the offline demo responder.
GROQ_API_KEY=

# Optional model override. Default: openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------
# Contact form (src/app/api/contact/route.ts)
# ------------------------------------------------------------------

# Where inquiries are delivered.
CONTACT_TO_EMAIL=mohamadanzarpangcoga@gmail.com

# Optional. Leave this empty/unset and the form uses FormSubmit instead
# (no account, no key). The first submission sends a one-time activation
# email to CONTACT_TO_EMAIL; click it once and subsequent mail is delivered.
# RESEND_API_KEY=re_xxxxxxxx

# Only used with Resend. Must be a verified domain in Resend, or leave
# unset to send from onboarding@resend.dev (delivers to your own address only).
# CONTACT_FROM_EMAIL="Anzyy Dev <hello@anzyy.dev>"
